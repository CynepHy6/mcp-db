#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# cwd = каталог инструмента, чтобы относительный mcp-db-server.log писался сюда,
# а не в рабочий каталог клиента (Claude Code держит cwd на корне воркспейса).
cd "$SCRIPT_DIR"

exec "$SCRIPT_DIR/venv/bin/python" "$SCRIPT_DIR/mcp-db-server.py" "$@"
