#!/bin/bash
# Local-clone launcher kept for MCP configs that point at this file.
# Needs `npm install && npm run compile` once; with npx use github:CynepHy6/mcp-db instead.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ ! -f "$SCRIPT_DIR/build/index.js" ]; then
    echo "mcp-db: build/index.js not found — run 'npm install && npm run compile' in $SCRIPT_DIR" >&2
    exit 1
fi

exec node "$SCRIPT_DIR/build/index.js" "$@"
